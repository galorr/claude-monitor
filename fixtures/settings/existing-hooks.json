{
  "permissions": {
    "allow": [
      "Bash(git status)"
    ],
    "deny": []
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/guard.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/format.js\""
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/lint.js\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"edited\\tfile\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"done\" with title \"Claude — ünïcode\"'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "example@plugins-repo": true
  },
  "theme": "dark",
  "ratio": 1.5
}
